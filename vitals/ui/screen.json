{
  "$schema": "https://mathieudvv.github.io/WinMore-releases/data/screen.schema.json",
  "type": "screen",
  "title": "Vitals",
  "chrome": "fullscreen",
  "background": "#0C1118",
  "surface": "#17212D",
  "accent": "mint",
  "state": {
    "editorId": "cpu",
    "editorName": "Processeur",
    "editorSize": "large",
    "editorColor": "mint",
    "editorVisible": true,
    "editorWarning": 75,
    "editorCritical": 90,
    "editorMax": 100,
    "editorLow": false,
    "editorUnit": "%",
    "pendingInterval": null,
    "pendingNotifications": null,
    "page": 0,
    "pendingLanguage": null
  },
  "let": {
    "editing": {
      "find": [
        "$widgets",
        "id",
        "$ui.editorId"
      ]
    }
  },
  "refresh": {
    "interval": 1.5,
    "fast": 0.5,
    "fastWhen": "$loading"
  },
  "bar": {
    "leading": [
      {
        "type": "label",
        "text": {
          "if": [
            "$alerts",
            "$status",
            "Vitals"
          ]
        },
        "symbol": "waveform.path.ecg",
        "style": "subheadline",
        "weight": "semibold",
        "iconColor": "$statusTint",
        "glass": true,
        "shape": "capsule",
        "padding": [
          8,
          12
        ]
      }
    ],
    "trailing": [
      {
        "type": "button",
        "symbol": "arrow.clockwise",
        "variant": "glass",
        "accessibility": "$t.refresh",
        "action": {
          "command": "refresh",
          "value": null
        },
        "loading": "$refreshing"
      },
      {
        "type": "button",
        "symbol": "square.grid.2x2",
        "variant": "glass",
        "accessibility": "$t.openEditor",
        "action": {
          "command": "openEditor",
          "value": null
        }
      },
      {
        "type": "button",
        "symbol": "slider.horizontal.3",
        "variant": "glass",
        "accessibility": "$t.openSettings",
        "action": {
          "sheet": "settings"
        }
      }
    ]
  },
  "body": {
    "type": "pager",
    "height": "screen",
    "bind": "page",
    "indicator": "auto",
    "children": [
      {
        "type": "each",
        "items": "$pages",
        "as": "pg",
        "id": "id",
        "template": {
          "type": "stack",
          "key": "$pg.id",
          "spacing": 12,
          "padding": [
            72,
            16,
            16,
            16
          ],
          "fill": "both",
          "children": [
            {
              "type": "progress",
              "label": "$t.loading",
              "tint": "mint",
              "when": "$loading"
            },
            {
              "type": "each",
              "items": "$pg.rows",
              "as": "row",
              "id": "id",
              "template": {
                "type": "grid",
                "key": "$row.id",
                "columns": "$row.columns",
                "spacing": 12,
                "children": [
                  {
                    "type": "each",
                    "items": "$row.tiles",
                    "as": "tile",
                    "id": "id",
                    "template": {
                      "type": "card",
                      "key": "$tile.id",
                      "inset": 12,
                      "spacing": 6,
                      "height": "$row.height",
                      "fill": "width",
                      "accessibility": "{{tile.name}} : {{tile.displayText}}, {{tile.statusLabel}}",
                      "children": [
                        {
                          "type": "label",
                          "text": "$tile.name",
                          "symbol": "$tile.symbol",
                          "style": "caption",
                          "weight": "semibold",
                          "color": "secondary",
                          "iconColor": "$tile.tint",
                          "lines": 1,
                          "when": "$tile.showLabel"
                        },
                        {
                          "type": "text",
                          "text": "$tile.name",
                          "style": "caption2",
                          "color": "secondary",
                          "lines": 1,
                          "when": "$tile.compact"
                        },
                        {
                          "type": "if",
                          "test": {
                            "and": [
                              "$tile.available",
                              {
                                "eq": [
                                  "$tile.display",
                                  "gauge"
                                ]
                              }
                            ]
                          },
                          "then": {
                            "type": "gauge",
                            "value": "$tile.value",
                            "min": 0,
                            "max": "$tile.max",
                            "text": "$tile.number",
                            "tint": "$tile.tint",
                            "height": "$tile.gaugeHeight",
                            "fill": "width"
                          },
                          "else": {
                            "type": "stack",
                            "spacing": 6,
                            "fill": "both",
                            "children": [
                              {
                                "type": "spacer"
                              },
                              {
                                "type": "stack",
                                "axis": "horizontal",
                                "spacing": 4,
                                "alignment": "bottom",
                                "children": [
                                  {
                                    "type": "text",
                                    "text": "$tile.number",
                                    "size": "$tile.bigSize",
                                    "weight": "heavy",
                                    "monospaced": true,
                                    "color": "$tile.tint",
                                    "lines": 1
                                  },
                                  {
                                    "type": "text",
                                    "text": "$tile.unit",
                                    "style": "caption",
                                    "weight": "semibold",
                                    "color": "secondary",
                                    "lines": 1
                                  }
                                ]
                              },
                              {
                                "type": "progress",
                                "value": "$tile.ratio",
                                "tint": "$tile.tint",
                                "when": {
                                  "eq": [
                                    "$tile.display",
                                    "bar"
                                  ]
                                }
                              },
                              {
                                "type": "chart",
                                "values": "$tile.history",
                                "kind": "area",
                                "tint": "$tile.tint",
                                "min": 0,
                                "height": "$tile.chartHeight",
                                "fill": "width",
                                "when": "$tile.showChart"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "type": "spacer"
            }
          ]
        }
      }
    ]
  },
  "sheets": {
    "editor": {
      "title": "$t.editMetric",
      "detents": [
        "large"
      ],
      "bar": {
        "trailing": [
          {
            "type": "button",
            "label": "$t.save",
            "action": [
              {
                "command": "saveWidget",
                "value": {
                  "id": "$ui.editorId",
                  "visible": "$ui.editorVisible",
                  "size": "$ui.editorSize",
                  "color": "$ui.editorColor",
                  "warning": "$ui.editorWarning",
                  "critical": "$ui.editorCritical"
                }
              },
              {
                "refresh": true
              },
              {
                "dismiss": true
              }
            ],
            "variant": "prominent"
          }
        ]
      },
      "body": {
        "type": "list",
        "children": [
          {
            "type": "section",
            "title": "$ui.editorName",
            "children": [
              {
                "type": "stat",
                "label": "$t.current",
                "value": "$editing.display",
                "symbol": "$editing.symbol"
              },
              {
                "type": "text",
                "text": "$editing.detail",
                "style": "caption",
                "color": "secondary"
              }
            ]
          },
          {
            "type": "section",
            "title": "$t.appearance",
            "children": [
              {
                "type": "picker",
                "label": "$t.color",
                "value": "$ui.editorColor",
                "options": [
                  {
                    "label": "$colorNames.mint",
                    "value": "mint"
                  },
                  {
                    "label": "$colorNames.cyan",
                    "value": "cyan"
                  },
                  {
                    "label": "$colorNames.blue",
                    "value": "blue"
                  },
                  {
                    "label": "$colorNames.indigo",
                    "value": "indigo"
                  },
                  {
                    "label": "$colorNames.purple",
                    "value": "purple"
                  },
                  {
                    "label": "$colorNames.pink",
                    "value": "pink"
                  },
                  {
                    "label": "$colorNames.green",
                    "value": "green"
                  },
                  {
                    "label": "$colorNames.orange",
                    "value": "orange"
                  },
                  {
                    "label": "$colorNames.yellow",
                    "value": "yellow"
                  },
                  {
                    "label": "$colorNames.white",
                    "value": "white"
                  }
                ],
                "action": {
                  "set": "editorColor",
                  "value": "$value"
                },
                "variant": "menu"
              },
              {
                "type": "badge",
                "text": "$t.colorPreview",
                "symbol": "$editing.symbol",
                "tint": "$ui.editorColor"
              }
            ]
          },
          {
            "type": "section",
            "title": "{{t.thresholds}} · {{ui.editorUnit}}",
            "children": [
              {
                "type": "text",
                "text": {
                  "if": [
                    "$ui.editorLow",
                    "$t.lowHelp",
                    "$t.highHelp"
                  ]
                },
                "style": "footnote",
                "color": "secondary"
              },
              {
                "type": "stepper",
                "label": "{{t.warning}} · {{ui.editorWarning}} {{ui.editorUnit}}",
                "value": "$ui.editorWarning",
                "min": 0,
                "max": "$ui.editorMax",
                "step": 1,
                "action": {
                  "set": "editorWarning",
                  "value": "$value"
                }
              },
              {
                "type": "stepper",
                "label": "{{t.critical}} · {{ui.editorCritical}} {{ui.editorUnit}}",
                "value": "$ui.editorCritical",
                "min": 0,
                "max": "$ui.editorMax",
                "step": 1,
                "action": {
                  "set": "editorCritical",
                  "value": "$value"
                }
              },
              {
                "type": "text",
                "text": "$t.colorsHelp",
                "style": "caption",
                "color": "secondary"
              }
            ]
          },
          {
            "type": "button",
            "label": "$t.cancel",
            "action": {
              "dismiss": true
            },
            "variant": "plain"
          }
        ]
      }
    },
    "settings": {
      "title": "$t.settings",
      "detents": [
        "large"
      ],
      "bar": {
        "trailing": [
          {
            "type": "button",
            "label": "$t.done",
            "action": {
              "dismiss": true
            },
            "variant": "plain"
          }
        ]
      },
      "body": {
        "type": "list",
        "children": [
          {
            "type": "section",
            "title": "$t.metrics",
            "children": [
              {
                "type": "text",
                "text": "$t.metricsHelp",
                "style": "footnote",
                "color": "secondary"
              },
              {
                "type": "button",
                "label": "$t.openEditor",
                "symbol": "square.grid.2x2",
                "variant": "bordered",
                "action": {
                  "command": "openEditor",
                  "value": null
                }
              },
              {
                "type": "each",
                "items": "$widgets",
                "as": "widget",
                "id": "id",
                "template": {
                  "type": "row",
                  "key": "$widget.id",
                  "title": "$widget.name",
                  "subtitle": {
                    "if": [
                      "$widget.visible",
                      "$widget.display",
                      "$t.onNoPage"
                    ]
                  },
                  "symbol": "$widget.symbol",
                  "value": {
                    "if": [
                      "$widget.visible",
                      "$t.shown",
                      "—"
                    ]
                  },
                  "accessory": "chevron",
                  "tint": "$widget.color",
                  "action": [
                    {
                      "dismiss": true
                    },
                    {
                      "set": "editorId",
                      "value": "$widget.id"
                    },
                    {
                      "set": "editorName",
                      "value": "$widget.name"
                    },
                    {
                      "set": "editorSize",
                      "value": "$widget.size"
                    },
                    {
                      "set": "editorColor",
                      "value": "$widget.color"
                    },
                    {
                      "set": "editorVisible",
                      "value": "$widget.visible"
                    },
                    {
                      "set": "editorWarning",
                      "value": "$widget.warning"
                    },
                    {
                      "set": "editorCritical",
                      "value": "$widget.critical"
                    },
                    {
                      "set": "editorMax",
                      "value": "$widget.max"
                    },
                    {
                      "set": "editorLow",
                      "value": "$widget.low"
                    },
                    {
                      "set": "editorUnit",
                      "value": "$widget.unit"
                    },
                    {
                      "sheet": "editor"
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "section",
            "title": "$t.collection",
            "children": [
              {
                "type": "picker",
                "label": "$t.interval",
                "value": {
                  "coalesce": [
                    "$ui.pendingInterval",
                    "$interval"
                  ]
                },
                "options": [
                  {
                    "label": "1 s",
                    "value": 1
                  },
                  {
                    "label": "2 s",
                    "value": 2
                  },
                  {
                    "label": "5 s",
                    "value": 5
                  }
                ],
                "action": [
                  {
                    "set": "pendingInterval",
                    "value": "$value"
                  },
                  {
                    "command": "interval",
                    "value": "$value",
                    "onError": {
                      "set": "pendingInterval",
                      "value": null
                    }
                  },
                  {
                    "refresh": true
                  },
                  {
                    "set": "pendingInterval",
                    "value": null
                  }
                ]
              },
              {
                "type": "text",
                "text": "$t.intervalHelp",
                "style": "caption",
                "color": "secondary"
              },
              {
                "type": "toggle",
                "label": "$t.notify",
                "symbol": "bell",
                "value": {
                  "coalesce": [
                    "$ui.pendingNotifications",
                    "$notifications"
                  ]
                },
                "action": [
                  {
                    "set": "pendingNotifications",
                    "value": "$value"
                  },
                  {
                    "command": "notifications",
                    "value": "$value",
                    "onError": {
                      "set": "pendingNotifications",
                      "value": null
                    }
                  },
                  {
                    "refresh": true
                  },
                  {
                    "set": "pendingNotifications",
                    "value": null
                  }
                ]
              },
              {
                "type": "text",
                "text": "$t.notifyHelp",
                "style": "caption",
                "color": "secondary"
              }
            ]
          },
          {
            "type": "section",
            "title": "$t.language",
            "children": [
              {
                "type": "picker",
                "label": "$t.language",
                "value": {
                  "coalesce": [
                    "$ui.pendingLanguage",
                    "$language"
                  ]
                },
                "options": "$languages",
                "action": [
                  {
                    "set": "pendingLanguage",
                    "value": "$value"
                  },
                  {
                    "command": "language",
                    "value": "$value",
                    "onError": {
                      "set": "pendingLanguage",
                      "value": null
                    }
                  },
                  {
                    "refresh": true
                  },
                  {
                    "set": "pendingLanguage",
                    "value": null
                  }
                ]
              }
            ]
          },
          {
            "type": "section",
            "title": "$t.sensors",
            "children": [
              {
                "type": "row",
                "title": "$t.sources",
                "subtitle": "$availableText",
                "symbol": "waveform.path.ecg",
                "accessory": "chevron",
                "action": [
                  {
                    "dismiss": true
                  },
                  {
                    "sheet": "sensors"
                  }
                ]
              },
              {
                "type": "row",
                "title": "$t.telemetry",
                "value": {
                  "if": [
                    "$telemetryConnected",
                    "$t.connected",
                    "$t.notConnected"
                  ]
                },
                "symbol": "cable.connector"
              }
            ]
          },
          {
            "type": "section",
            "title": "$t.thisComputer",
            "children": [
              {
                "type": "row",
                "title": "$host",
                "subtitle": "$system",
                "symbol": "desktopcomputer"
              },
              {
                "type": "text",
                "text": "$cpuModel",
                "style": "caption",
                "color": "secondary"
              },
              {
                "type": "text",
                "text": "$t.privacy",
                "style": "caption",
                "color": "secondary"
              }
            ]
          }
        ]
      }
    },
    "sensors": {
      "title": "$t.sourcesTitle",
      "detents": [
        "large"
      ],
      "body": {
        "type": "list",
        "children": [
          {
            "type": "section",
            "title": "$t.measured",
            "children": [
              {
                "type": "text",
                "text": "$t.measuredHelp",
                "style": "footnote",
                "color": "secondary"
              }
            ]
          },
          {
            "type": "section",
            "title": "$t.gpuTitle",
            "children": [
              {
                "type": "text",
                "text": "$t.gpuHelp",
                "style": "footnote",
                "color": "secondary"
              }
            ]
          },
          {
            "type": "section",
            "title": "$t.fpsTitle",
            "children": [
              {
                "type": "text",
                "text": "$t.fpsHelp",
                "style": "footnote",
                "color": "secondary"
              },
              {
                "type": "text",
                "text": "$t.telemetryHelp",
                "style": "footnote",
                "color": "secondary"
              },
              {
                "type": "text",
                "text": "$t.expiryHelp",
                "style": "caption",
                "color": "secondary"
              }
            ]
          },
          {
            "type": "section",
            "title": "$t.sourceState",
            "children": [
              {
                "type": "each",
                "items": "$widgets",
                "as": "widget",
                "id": "id",
                "template": {
                  "type": "row",
                  "key": "$widget.id",
                  "title": "$widget.name",
                  "subtitle": {
                    "if": [
                      "$widget.available",
                      "$widget.source",
                      "$widget.detail"
                    ]
                  },
                  "value": "$widget.display",
                  "symbol": "$widget.symbol"
                }
              }
            ]
          },
          {
            "type": "button",
            "label": "$t.close",
            "action": {
              "dismiss": true
            },
            "variant": "plain"
          }
        ]
      }
    }
  }
}
